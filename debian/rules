#!/usr/bin/make -f

%:
	dh $@

override_dh_install:
	dh_install
	mkdir -p debian/freedomnas-installer/usr/lib/freedomnas/installer/lib
	install -m 755 setup.py debian/freedomnas-installer/usr/lib/freedomnas/installer/setup.py
	install -m 644 lib/*.py debian/freedomnas-installer/usr/lib/freedomnas/installer/lib/
	mkdir -p debian/freedomnas-installer/usr/bin
	ln -sf /usr/lib/freedomnas/installer/setup.py debian/freedomnas-installer/usr/bin/freedomnas-install
